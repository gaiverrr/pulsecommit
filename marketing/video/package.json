{
  "name": "pulsecommit-hero-video",
  "version": "1.0.0",
  "private": true,
  "description": "Hero loop for pulsecommit.app, rendered with Remotion from simulator screenshots.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "render": "npm run typecheck && node scripts/render.mjs",
    "render:store": "npm run typecheck && node scripts/render-store.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.5",
    "@fontsource/jetbrains-mono": "5.2.5",
    "@remotion/cli": "4.0.540",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "typescript": "5.7.3"
  }
}
